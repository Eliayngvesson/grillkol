# Kopiera till .env.local (lokalt) och Vercel. Lägg ALDRIG in riktiga värden i Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Delad hemlighet med AppCenter (minst 32 tecken: openssl rand -hex 32). Utan den svarar /api/appcenter 503.
APPCENTER_SHARED_SECRET=
APPCENTER_SHARED_SECRET_PREVIOUS=   # bara under nyckelbyte
